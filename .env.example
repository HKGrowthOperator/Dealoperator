# Fill only after the new project and concrete connection are approved.
# Empty values keep external authentication and data storage disabled.
APP_URL=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Server-only PostgreSQL connection URL, with validated TLS.
# Use the approved Supabase session pooler connection for this persistent Node server.
DATABASE_URL=
# Optional PEM certificate from the Supabase Connect dialog. Literal \n is supported.
DATABASE_SSL_CA=
# Keep empty in production. "disable" is accepted for a loopback-only local database.
DATABASE_SSL=
# Comma-separated verified auth user IDs. Never public email/name matching.
OPERATOR_ADMIN_IDS=
# Optional override; the website defaults to Nick’s official https://discord.gg/NjkFJtBkZm invitation.
DISCORD_INVITE_URL=
